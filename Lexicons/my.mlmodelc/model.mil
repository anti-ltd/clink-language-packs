            tensor<bool, [3]> input_squeeze_mask_0 = const()[name = tensor<string, []>("input_squeeze_mask_0"), val = tensor<bool, [3]>([true, false, false])];
            tensor<fp16, [1, 256]> input_cast_fp16 = slice_by_index(begin = input_begin_0, end = input_end_0, end_mask = input_end_mask_0, squeeze_mask = input_squeeze_mask_0, x = h_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp16, [128, 256]> proj_weight_to_fp16_quantized = constexpr_affine_dequantize()[axis = tensor<int32, []>(0), name = tensor<string, []>("proj_weight_to_fp16_quantized"), quantized_data = tensor<int8, [128, 256]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(1053696))), scale = tensor<fp16, [128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(1086720))), zero_point = tensor<int8, [128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(1086528)))];
            tensor<fp16, [128]> linear_24_bias_0_to_fp16 = const()[name = tensor<string, []>("linear_24_bias_0_to_fp16"), val = tensor<fp16, [128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(1087040)))];
            tensor<fp16, [1, 128]> linear_24_cast_fp16 = linear(bias = linear_24_bias_0_to_fp16, weight = proj_weight_to_fp16_quantized, x = input_cast_fp16)[name = tensor<string, []>("linear_24_cast_fp16")];
            tensor<fp16, [2643]> logits_bias_0_to_fp16 = const()[name = tensor<string, []>("logits_bias_0_to_fp16"), val = tensor<fp16, [2643]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(1087360)))];
            tensor<fp16, [1, 2643]> logits_cast_fp16 = linear(bias = logits_bias_0_to_fp16, weight = emb_weight_to_fp16_quantized, x = linear_24_cast_fp16)[name = tensor<string, []>("logits_cast_fp16")];
            tensor<int32, []> var_45 = const()[name = tensor<string, []>("op_45"), val = tensor<int32, []>(-1)];
            tensor<fp16, [1, 2643]> var_47_softmax_cast_fp16 = softmax(axis = var_45, x = logits_cast_fp16)[name = tensor<string, []>("op_47_softmax_cast_fp16")];
            tensor<fp32, []> var_47_epsilon_0 = const()[name = tensor<string, []>("op_47_epsilon_0"), val = tensor<fp32, []>(0x1p-149)];
            tensor<fp16, [1, 2643]> logProbs = log(epsilon = var_47_epsilon_0, x = var_47_softmax_cast_fp16)[name = tensor<string, []>("op_47_cast_fp16")];
        } -> (logProbs);
}